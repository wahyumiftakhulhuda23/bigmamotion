{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/|favicon\\.ico|robots\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
